type Query {
    posts(filters: PostFilters): [Post!]!
    post(id: ID!): Post
    categories: [String!]!
    tags: [String!]!
}

type Mutation {
    createPost(input: PostInput!): Post!
    updatePost(id: ID!, input: PostInput!): Post!
    deletePost(id: ID!): Boolean!
}

type Post {
    id: ID!
    title: String!
    slug: String!
    excerpt: String
    content: String!
    author: Author!
    tags: [String!]
    category: String
    published: Boolean!
    publishedAt: String
    createdAt: String!
    updatedAt: String!
    views: Int
}

type Author {
    id: Int!
    name: String!
    email: String!
}

input PostInput {
    title: String!
    slug: String
    excerpt: String
    content: String!
    tags: [String!]
    category: String
    published: Boolean
}

input PostFilters {
    published: Boolean
    category: String
    tag: String
    search: String
    limit: Int
}
