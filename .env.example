# Environment variables for local development
# Copy this file to .env and update the values

# Auth Service (Node.js)
AUTH_SERVICE_PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_db

# Blog Service (Java Spring Boot)
BLOG_SERVICE_PORT=3002
MONGO_DATABASE=blog_db

# AWS S3 Configuration (for blog widget images)
AWS_S3_BUCKET_NAME=das-blog-widgets
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Portfolio Service (Kotlin Spring Boot)
PORTFOLIO_SERVICE_PORT=3003
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=portfolio_db

# Frontend
FRONTEND_PORT=3000
