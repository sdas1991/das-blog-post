# Environment Configuration for DAS Blog & Portfolio Platform
# Copy this file to .env and update with your actual values

# ============================================
# General Configuration
# ============================================
NODE_ENV=development
# Options: development, production

# ============================================
# Auth Service - PostgreSQL Configuration
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=auth_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_very_secure_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
# Token expiration time: 1d, 7d, 30d, etc.

# ============================================
# Blog Service - MongoDB Configuration
# ============================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=blog_db
MONGO_USER=
MONGO_PASSWORD=

# ============================================
# Portfolio Service - MySQL Configuration
# ============================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=portfolio_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# ============================================
# Email Configuration (Optional - For Notifications)
# ============================================
# Required for guest author email notifications
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Gmail Setup Instructions:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account > Security > 2-Step Verification > App passwords
# 3. Generate an app password and use it above

# ============================================
# Application URLs (For Production)
# ============================================
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost

# For production, update to:
# FRONTEND_URL=https://yourdomain.com
# API_BASE_URL=https://api.yourdomain.com

# ============================================
# Service Ports
# ============================================
# These are internal Docker network ports
# External access is mapped in docker-compose.yml

AUTH_SERVICE_PORT=3001
BLOG_SERVICE_PORT=3002
PORTFOLIO_SERVICE_PORT=3003
FRONTEND_PORT=3000

# ============================================
# AWS Configuration (For Deployment)
# ============================================
# Uncomment and configure for AWS deployment
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-backup-bucket-name

# ============================================
# Redis Configuration (Optional - For Caching)
# ============================================
# Uncomment if you add Redis
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ============================================
# Security & Rate Limiting
# ============================================
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# File Upload Configuration
# ============================================
# MAX_FILE_SIZE=5242880
# 5MB = 5 * 1024 * 1024 bytes

# ALLOWED_FILE_TYPES=jpeg,jpg,png,gif,pdf,doc,docx

# ============================================
# Logging
# ============================================
# LOG_LEVEL=info
# Options: error, warn, info, debug

# ============================================
# NOTES
# ============================================
# 1. Never commit the .env file to version control
# 2. Keep production secrets secure and rotate regularly
# 3. Use strong passwords (minimum 12 characters, mix of letters/numbers/symbols)
# 4. For production, consider using AWS Secrets Manager or similar
# 5. Refer to docs/AWS_DEPLOYMENT_GUIDE.md for deployment instructions
