# Environment variables for local development
# Copy this file to .env and update the values

# ============================================
# APPLICATION MODE
# ============================================
# Set to "dev" for local development (no AWS dependencies)
# Set to "release" for production (uses AWS services)
APP_MODE=dev

# ============================================
# SERVICE PORTS
# ============================================
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=3001
BLOG_SERVICE_PORT=3002
PORTFOLIO_SERVICE_PORT=3003
FRONTEND_PORT=3000

# ============================================
# API GATEWAY RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# AUTH SERVICE
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE=5242880

# ============================================
# DATABASES (Dev Mode)
# ============================================
# PostgreSQL (Auth Service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_db

# MongoDB (Blog Service + File Storage)
MONGO_DATABASE=blog_db

# MySQL (Portfolio Service)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=portfolio_db

# ============================================
# AWS CONFIGURATION (Release Mode Only)
# ============================================
# Only required when APP_MODE=release
# Uncomment and configure these for production deployment

# AWS_REGION=us-east-1
# AWS_S3_BUCKET=das-blog-uploads
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
